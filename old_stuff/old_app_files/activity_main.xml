<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flare_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- FLARE BRAND HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/flare_logo_bg"
                android:gravity="center"
                android:text="F"
                android:textColor="@color/flare_cyan"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FLARE"
                    android:textColor="@color/flare_white"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FLOOD &amp; LANDSLIDE RESCUE"
                    android:textColor="@color/flare_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONITORING SYSTEM  •  V2"
                    android:textColor="@color/flare_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONNECTION STATUS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/flare_card"
            android:padding="16dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVICE CONNECTION"
                android:textColor="@color/flare_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/connectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ESP32: DISCONNECTED"
                android:textColor="@color/flare_cyan"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingTop="9dp" />
        </LinearLayout>

        <!-- THREAT STATUS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENVIRONMENTAL OVERVIEW"
            android:textColor="@color/flare_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/flare_status_card"
            android:padding="18dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT THREAT STATUS"
                android:textColor="@color/flare_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/threatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THREAT: WAITING FOR DATA"
                android:textColor="@color/flare_cyan"
                android:textSize="21sp"
                android:textStyle="bold"
                android:paddingTop="12dp"
                android:paddingBottom="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Based on available ESP32 sensor readings"
                android:textColor="@color/flare_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- SENSOR SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE SENSOR MONITORING"
            android:textColor="@color/flare_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <!-- SENSOR ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- WATER -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="@drawable/flare_card"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="≈  WATER"
                    android:textColor="@color/flare_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/waterValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Water: N/A"
                    android:textColor="@color/flare_white"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="13dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Water level"
                    android:textColor="@color/flare_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="5dp" />
            </LinearLayout>

            <!-- RAIN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="@drawable/flare_card"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☂  RAIN"
                    android:textColor="@color/flare_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rainValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rain: N/A"
                    android:textColor="@color/flare_white"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="13dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rainfall sensor"
                    android:textColor="@color/flare_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="5dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SENSOR ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- SOIL -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="@drawable/flare_card"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌁  SOIL"
                    android:textColor="@color/flare_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/soilValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Soil: N/A"
                    android:textColor="@color/flare_white"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="13dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Soil moisture"
                    android:textColor="@color/flare_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="5dp" />
            </LinearLayout>

            <!-- RISK -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="@drawable/flare_risk_card"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◉  RISK SCORE"
                    android:textColor="@color/flare_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/riskValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RISK SCORE: UNAVAILABLE"
                    android:textColor="@color/flare_white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="13dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prototype estimate"
                    android:textColor="@color/flare_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="5dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SOS SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY RESPONSE"
            android:textColor="@color/flare_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/flare_sos_card"
            android:padding="18dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLARE SOS SYSTEM"
                android:textColor="@color/flare_white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sosStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SOS: STANDBY"
                android:textColor="@color/flare_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="14dp" />

            <TextView
                android:id="@+id/alarmStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ALARM: OFF"
                android:textColor="@color/flare_warning"
                android:textSize="14sp"
                android:paddingTop="8dp"
                android:paddingBottom="15dp" />

            <Button
                android:id="@+id/testSosButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/flare_button_primary"
                android:backgroundTint="@null"
                android:text="TEST SOS ALARM"
                android:textColor="@color/flare_button_text"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/stopAlarmButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/flare_button_secondary"
                android:backgroundTint="@null"
                android:text="ACKNOWLEDGE / STOP ALARM"
                android:textColor="@color/flare_white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- ESP32 CONFIGURATION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE CONFIGURATION"
            android:textColor="@color/flare_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/flare_card"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESP32 CONNECTION"
                android:textColor="@color/flare_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/esp32IpInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/flare_input"
                android:hint="Enter ESP32 IP address"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/flare_white"
                android:textColorHint="@color/flare_muted"
                android:textSize="14sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:selectAllOnFocus="true" />

            <Button
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/flare_button_primary"
                android:backgroundTint="@null"
                android:text="CONNECT TO ESP32"
                android:textColor="@color/flare_button_text"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FLARE V2  •  INTELLIGENT ENVIRONMENTAL MONITORING"
            android:textColor="@color/flare_muted"
            android:textSize="9sp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingTop="25dp"
            android:paddingBottom="12dp" />

    </LinearLayout>
</ScrollView>
